# AI-CMS Backend .env (本地开发示例)
# 复制为 .env 后使用

PROJECT_NAME=AI-CMS
VERSION=0.1.0
DEBUG=true
ENV=dev
TZ=Asia/Shanghai

# API
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost","http://localhost:5173","http://localhost:3000","http://localhost:8000"]

# 安全
SECRET_KEY=dev-secret-key-please-change-in-production-32bytes-min
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# 数据库 (本地 docker compose 默认值)
DATABASE_URL=postgresql+asyncpg://ai_cms:change_me_pg@localhost:5432/ai_cms

# Redis
REDIS_URL=redis://localhost:6379/0

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=ai_cms
MINIO_SECRET_KEY=change_me_minio
MINIO_BUCKET=media

# AI
AI_DEFAULT_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
