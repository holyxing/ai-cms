---
// SubCategoryNav.astro - 二级栏目导航
// 用途: 新闻资讯 / 文档中心 等多子栏目场景
// 渲染位置: 一级栏目页 + 各子栏目页顶部
//
// 入参:
//   - currentSlug: 当前栏目 slug (高亮)
//   - siblings: [{ slug, name }]
//   - parentHref: 父栏目链接 (面包屑返回)
---
{interface Props {
  currentSlug?: string;
  siblings: Array<{ slug: string; name: string }>;
  parentName?: string;
  parentHref?: string;
}}

const { currentSlug, siblings, parentName, parentHref } = Astro.props;
---

{siblings.length > 0 && (
  <nav class="subcat-nav" aria-label="子栏目导航">
    {parentName && parentHref && (
      <a href={parentHref} class="subcat-parent">← {parentName}</a>
    )}
    <ul class="subcat-list">
      {siblings.map((s) => (
        <li>
          <a
            href={`/categories/${s.slug}/`}
            class:list={['subcat-link', { active: s.slug === currentSlug }]}
            aria-current={s.slug === currentSlug ? 'page' : undefined}
          >
            {s.name}
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}

<style>
  .subcat-nav {
    margin-bottom: var(--spacing-xl);
    padding-bottom: var(--spacing-md);
    border-bottom: 1px solid var(--color-border);
  }
  .subcat-parent {
    display: inline-block;
    font-size: var(--fontSize-sm);
    color: var(--color-text-muted);
    text-decoration: none;
    margin-bottom: var(--spacing-sm);
  }
  .subcat-parent:hover {
    color: var(--color-primary);
  }
  .subcat-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-xs);
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .subcat-link {
    display: inline-block;
    padding: var(--spacing-xs) var(--spacing-md);
    font-size: var(--fontSize-sm);
    color: var(--color-text);
    text-decoration: none;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    transition: all 0.15s;
  }
  .subcat-link:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }
  .subcat-link.active {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: var(--color-primary-foreground);
    font-weight: 500;
  }
</style>
