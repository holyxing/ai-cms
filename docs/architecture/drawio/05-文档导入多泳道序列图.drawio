<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="OpenClaw" agent="MiniMax-M3" version="24.7.0">
  <diagram id="seq-import" name="文档导入多泳道序列图 (P3.9.5+)">
    <mxGraphModel dx="3000" dy="2200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="AI-CMS 文档导入 — 多泳道序列图 (6 泳道, P3.9.5+)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="1720" height="40" as="geometry" />
        </mxCell>

        <!-- ====== 泳道 (swimlane horizontal) ====== -->
        <mxCell id="sw-user" value="运营" style="swimlane;startSize=30;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#ffffff;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="280" height="1280" as="geometry" />
        </mxCell>
        <mxCell id="sw-fe" value="前端 React" style="swimlane;startSize=30;fillColor=#fff2cc;strokeColor=#d6b656;swimlaneFillColor=#ffffff;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="320" y="60" width="280" height="1280" as="geometry" />
        </mxCell>
        <mxCell id="sw-api" value="FastAPI" style="swimlane;startSize=30;fillColor=#ffe6cc;strokeColor=#d79b00;swimlaneFillColor=#ffffff;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="600" y="60" width="280" height="1280" as="geometry" />
        </mxCell>
        <mxCell id="sw-wk" value="Celery Worker" style="swimlane;startSize=30;fillColor=#e1d5e7;strokeColor=#9673a6;swimlaneFillColor=#ffffff;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="880" y="60" width="280" height="1280" as="geometry" />
        </mxCell>
        <mxCell id="sw-minio" value="MinIO" style="swimlane;startSize=30;fillColor=#d5e8d4;strokeColor=#82b366;swimlaneFillColor=#ffffff;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1160" y="60" width="280" height="1280" as="geometry" />
        </mxCell>
        <mxCell id="sw-llm" value="LLM Provider" style="swimlane;startSize=30;fillColor=#fad7ac;strokeColor=#b46504;swimlaneFillColor=#ffffff;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1440" y="60" width="320" height="1280" as="geometry" />
        </mxCell>

        <!-- 泳道生命线 (dashed vertical lines) -->
        <mxCell id="ll-user" style="endArrow=none;dashed=1;html=1;strokeColor=#6c8ebf" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="180" y="100" as="sourcePoint" />
            <mxPoint x="180" y="1340" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="ll-fe" style="endArrow=none;dashed=1;html=1;strokeColor=#d6b656" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="460" y="100" as="sourcePoint" />
            <mxPoint x="460" y="1340" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="ll-api" style="endArrow=none;dashed=1;html=1;strokeColor=#d79b00" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="740" y="100" as="sourcePoint" />
            <mxPoint x="740" y="1340" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="ll-wk" style="endArrow=none;dashed=1;html=1;strokeColor=#9673a6" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1020" y="100" as="sourcePoint" />
            <mxPoint x="1020" y="1340" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="ll-minio" style="endArrow=none;dashed=1;html=1;strokeColor=#82b366" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1300" y="100" as="sourcePoint" />
            <mxPoint x="1300" y="1340" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="ll-llm" style="endArrow=none;dashed=1;html=1;strokeColor=#b46504" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1600" y="100" as="sourcePoint" />
            <mxPoint x="1600" y="1340" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- ====== 消息箭头 ====== -->
        <!-- Step 1: 用户点按钮 -->
        <mxCell id="step-note" value="场景: 用户在 ContentDetail 点 '导入 Word 文档' 按钮" style="text;html=1;strokeColor=#9673a6;fillColor=#e1d5e7;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=12;fontStyle=2" vertex="1" parent="1">
          <mxGeometry x="60" y="110" width="1660" height="40" as="geometry" />
        </mxCell>

        <mxCell id="m1" value="1. 点 '导入 Word 文档'" style="html=1;verticalAlign=bottom;endArrow=classic;strokeColor=#6c8ebf" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="180" y="180" as="sourcePoint" />
            <mxPoint x="460" y="180" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="a1" value="2. 隐藏 file input.click()" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="340" y="200" width="240" height="40" as="geometry" />
        </mxCell>

        <mxCell id="m2" value="3. 选 test.docx" style="html=1;verticalAlign=bottom;endArrow=classic;strokeColor=#d6b656" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="460" y="260" as="sourcePoint" />
            <mxPoint x="180" y="260" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Step 2: 前端上传文件 -->
        <mxCell id="m3" value="4. POST /media/upload (multipart)" style="html=1;verticalAlign=bottom;endArrow=classic;strokeColor=#d6b656" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="460" y="310" as="sourcePoint" />
            <mxPoint x="740" y="310" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="a2" value="5. boto3 put_object" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="620" y="330" width="240" height="40" as="geometry" />
        </mxCell>

        <mxCell id="m4" value="6. put_object" style="html=1;verticalAlign=bottom;endArrow=classic;strokeColor=#d79b00" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="740" y="380" as="sourcePoint" />
            <mxPoint x="1300" y="380" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="m5" value="7. presigned URL" style="html=1;verticalAlign=bottom;endArrow=classic;dashed=1;strokeColor=#82b366" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1300" y="420" as="sourcePoint" />
            <mxPoint x="740" y="420" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="m6" value="8. {url: /media/sites/.../test.docx?X-Amz-...}" style="html=1;verticalAlign=bottom;endArrow=classic;dashed=1;strokeColor=#d79b00" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="740" y="460" as="sourcePoint" />
            <mxPoint x="460" y="460" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Step 3: 启动 AI 任务 -->
        <mxCell id="m7" value="9. POST /ai/tasks/import_docx/start&#10;{ file_url, apply_layout: true }" style="html=1;verticalAlign=bottom;endArrow=classic;strokeColor=#d6b656" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="460" y="510" as="sourcePoint" />
            <mxPoint x="740" y="510" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="a3" value="10. 写 ai_runs (status=pending)&#10;    + ai_run_steps (validate, order=1)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="620" y="530" width="240" height="50" as="geometry" />
        </mxCell>

        <mxCell id="m8" value="11. 202 { run_id, stream_url }" style="html=1;verticalAlign=bottom;endArrow=classic;dashed=1;strokeColor=#d79b00" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="740" y="600" as="sourcePoint" />
            <mxPoint x="460" y="600" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="m9" value="12. enqueue execute_ai_run(run_id)" style="html=1;verticalAlign=bottom;endArrow=classic;strokeColor=#d79b00" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="740" y="640" as="sourcePoint" />
            <mxPoint x="1020" y="640" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Step 4: 前端订阅 SSE -->
        <mxCell id="m10" value="13. GET /ai/runs/{id}/stream (SSE)" style="html=1;verticalAlign=bottom;endArrow=classic;strokeColor=#d6b656" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="460" y="680" as="sourcePoint" />
            <mxPoint x="740" y="680" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- par 区块标记 -->
        <mxCell id="par-box" value="par (并行)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;fontSize=11;fontStyle=1;align=left;verticalAlign=top" vertex="1" parent="1">
          <mxGeometry x="60" y="720" width="1660" height="560" as="geometry" />
        </mxCell>

        <mxCell id="par-worker" value="Worker 执行" style="text;html=1;strokeColor=#9673a6;fillColor=#e1d5e7;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="900" y="730" width="240" height="30" as="geometry" />
        </mxCell>
        <mxCell id="par-fe" value="前端 SSE 推送" style="text;html=1;strokeColor=#d6b656;fillColor=#fff2cc;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="340" y="730" width="240" height="30" as="geometry" />
        </mxCell>

        <mxCell id="a4" value="14. 拉 ai_runs / 写 ai_run_steps (order=1, validate)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="900" y="770" width="240" height="50" as="geometry" />
        </mxCell>

        <mxCell id="m11" value="15. boto3 get_object" style="html=1;verticalAlign=bottom;endArrow=classic;strokeColor=#9673a6" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1020" y="840" as="sourcePoint" />
            <mxPoint x="1300" y="840" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m12" value="16. file_bytes (36805)" style="html=1;verticalAlign=bottom;endArrow=classic;dashed=1;strokeColor=#82b366" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1300" y="880" as="sourcePoint" />
            <mxPoint x="1020" y="880" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="a5" value="17. python-docx 解析段落&#10;    + 提取 word/media/ 图片" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="900" y="900" width="240" height="50" as="geometry" />
        </mxCell>

        <mxCell id="m13" value="18. 上传 base64 图" style="html=1;verticalAlign=bottom;endArrow=classic;strokeColor=#9673a6" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1020" y="970" as="sourcePoint" />
            <mxPoint x="1300" y="970" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="a6" value="19. 写 ai_run_steps&#10;    (order=2, generate)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="900" y="1000" width="240" height="50" as="geometry" />
        </mxCell>

        <mxCell id="opt-block" value="opt apply_layout = true" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fad7ac;strokeColor=#b46504;dashed=1;fontSize=11;fontStyle=1;align=left;verticalAlign=top" vertex="1" parent="1">
          <mxGeometry x="900" y="1060" width="800" height="170" as="geometry" />
        </mxCell>

        <mxCell id="m14" value="20. stream(messages, model=qwen2.5)" style="html=1;verticalAlign=bottom;endArrow=classic;strokeColor=#9673a6" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1020" y="1100" as="sourcePoint" />
            <mxPoint x="1600" y="1100" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="a7" value="21. 累计 delta (排版后 HTML)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fad7ac;strokeColor=#b46504;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="1460" y="1120" width="240" height="40" as="geometry" />
        </mxCell>

        <mxCell id="m15" value="22. prompt_tokens=289&#10;    completion_tokens=100&#10;    cost=$0.001089" style="html=1;verticalAlign=bottom;endArrow=classic;dashed=1;strokeColor=#b46504;fontSize=10" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1600" y="1180" as="sourcePoint" />
            <mxPoint x="1020" y="1180" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="a8" value="23. 写 content_versions&#10;    (HTML 主体, 永不删)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="900" y="1240" width="240" height="50" as="geometry" />
        </mxCell>

        <mxCell id="m16" value="24. 写 ai_runs (status=success)" style="html=1;verticalAlign=bottom;endArrow=classic;strokeColor=#9673a6" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1020" y="1280" as="sourcePoint" />
            <mxPoint x="740" y="1280" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- 前端 SSE 推送 -->
        <mxCell id="sse1" value="20. SSE: step=validate" style="html=1;verticalAlign=bottom;endArrow=classic;dashed=1;strokeColor=#d79b00" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="740" y="790" as="sourcePoint" />
            <mxPoint x="460" y="790" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="sse2" value="21. SSE: step=generate + delta" style="html=1;verticalAlign=bottom;endArrow=classic;dashed=1;strokeColor=#d79b00" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="740" y="1010" as="sourcePoint" />
            <mxPoint x="460" y="1010" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="sse3" value="22. SSE: step=save" style="html=1;verticalAlign=bottom;endArrow=classic;dashed=1;strokeColor=#d79b00" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="740" y="1250" as="sourcePoint" />
            <mxPoint x="460" y="1250" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="sse4" value="23. SSE: done" style="html=1;verticalAlign=bottom;endArrow=classic;dashed=1;strokeColor=#d79b00" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="740" y="1290" as="sourcePoint" />
            <mxPoint x="460" y="1290" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Step 5: 用户接受 -->
        <mxCell id="note2" value="前端收到 done 事件, 显示 diff 对话框" style="text;html=1;strokeColor=#d6b656;fillColor=#fff2cc;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=11;fontStyle=2" vertex="1" parent="1">
          <mxGeometry x="60" y="1310" width="1660" height="30" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
