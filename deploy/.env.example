# ====== AI-CMS 部署配置 ======
# 复制为 .env 后使用: cp .env.example .env

# ----- 全局 -----
PROJECT_NAME=ai-cms
TZ=Asia/Shanghai

# ----- Postgres -----
POSTGRES_USER=ai_cms
POSTGRES_PASSWORD=change_me_pg
POSTGRES_DB=ai_cms
POSTGRES_PORT=5432

# ----- Redis -----
REDIS_PORT=6379

# ----- MinIO -----
MINIO_ROOT_USER=ai_cms
MINIO_ROOT_PASSWORD=change_me_minio
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ----- Fernet (AI API key 加密, 生产必须配置) -----
# 开发可空, 但调用加解密时会 fail-fast
# 生成: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# ----- Backup (PG → MinIO 定时) -----
# 备份 bucket (自动创建)
MINIO_BACKUP_BUCKET=backups
# 保留天数 (7 表示刪 7 天前的)
BACKUP_RETENTION_DAYS=7

# ----- Backend (FastAPI) -----
API_PORT=8000
# 32 字节以上随机串
SECRET_KEY=please-change-me-to-a-random-32-byte-string-xxxxx
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# CORS 允许的来源（逗号分隔）
CORS_ORIGINS=http://localhost,http://localhost:5173,http://localhost:8000

# ----- Frontend (Admin) -----
# dev 模式直接 5173, prod 模式通过 nginx
FRONTEND_PORT=5173
# 前端用到的 API 地址（容器内可用服务名 api）
VITE_API_BASE=http://localhost:8000/api/v1

# ----- Nginx (prod) -----
NGINX_PORT=80

# ----- 发布产物存储路径 (P3.6.1+ 改为 host 可访问) -----
# 留空: 使用 named volume (容器内可见, host 看不到, 默认)
# 设为路径: bind mount 到 host, 发布产物直接可看 (推荐 dev)
# 例: SITES_DATA_HOST_PATH=$HOME/Sites/ai-cms
SITES_DATA_HOST_PATH=

# ----- AI Providers -----
# 默认启用的 provider (openai / minimax / ollama / anthropic / custom)
# 安全: 下列 *_API_KEY 只填在本地 deploy/.env，严禁提交到 Git / Issue / 截图
AI_DEFAULT_PROVIDER=openai
# OpenAI（留空则跳过在线调用）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Anthropic
ANTHROPIC_API_KEY=
# minimax (OpenAI 兼容)
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_DEFAULT_MODEL=abab6.5s-chat
# Ollama（可选，profile=ai-local 时启用）
OLLAMA_BASE_URL=http://ollama:11434
